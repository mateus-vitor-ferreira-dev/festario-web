# Copie para .env.local (não versionado) e preencha o que precisar. Todas são opcionais em dev.
# O Vite só lê este arquivo ao subir: depois de mudar, reinicie o `npm run dev`.

# URL base da API. Sem ela, http://localhost:3000.
VITE_API_URL=http://localhost:3000

# ID do cliente OAuth do Google: liga o botão "Entrar com Google" no login e no cadastro.
# Sem ele, o botão não aparece (o login por e-mail e senha continua funcionando).
# Use o MESMO ID em GOOGLE_CLIENT_ID da API (festario-api/.env.development), senão a API recusa o login.
# Google Cloud Console → APIs e Serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web),
# com http://localhost:5173 e http://localhost em "Origens JavaScript autorizadas".
VITE_GOOGLE_CLIENT_ID=

# DSN do Sentry. Vazia desliga o Sentry (deixe vazia em dev).
VITE_SENTRY_DSN=

# Só no build de produção (CI/Vercel): token para enviar os source maps ao Sentry. Não chega ao navegador.
SENTRY_AUTH_TOKEN=
